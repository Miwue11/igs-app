# Copia este archivo como .env y rellena los valores.
NODE_ENV=development
PUERTO=4000

# MongoDB Community Server en tu ordenador (gratis). Ábrelo con MongoDB Compass usando esta misma dirección.
# Alternativa gratuita en la nube: clúster M0 de MongoDB Atlas.
URI_MONGODB=mongodb://localhost:27017/igs

# Cadena larga y aleatoria. Obligatoria en producción.
SECRETO_JWT=cambia-esta-clave-por-una-larga-y-aleatoria

# Clave de los códigos UV anti-réplica de los slabs. Opcional (si falta se deriva de SECRETO_JWT).
# Fíjala antes de imprimir slabs reales y NO la cambies después: invalidaría los códigos ya impresos.
CLAVE_UV=

# Origen del cliente en desarrollo (Vite)
ORIGEN_CLIENTE=http://localhost:5173

# Carpeta donde se guardan las fotos subidas
CARPETA_FOTOS=fotos
# true → las fotos se guardan dentro de MongoDB en vez de en la carpeta (obligatorio en Render)
FOTOS_EN_MONGO=false
# true → si la base de datos está vacía al arrancar, carga los datos de demo (útil en el primer despliegue)
SEMBRAR_DEMO_SI_VACIA=false

# Web compilada (npm run build). Si existe, Express la sirve en el mismo puerto que la API.
CARPETA_WEB=../cliente/dist

# Copias de seguridad (npm run copia). Deja vacío lo que no uses.
#   COPIA_FISICA: pendrive o disco externo, p. ej. E:/IGS-copias
#   COPIA_NUBE: carpeta sincronizada gratis con Google Drive u OneDrive, p. ej. C:/Users/tu-usuario/OneDrive/IGS-copias
#   RUTA_HERRAMIENTAS_MONGO: (opcional) carpeta bin de las MongoDB Database Tools si no están en el PATH.
#   Sin las Database Tools la copia se hace igualmente, en JSON (.json.gz).
COPIA_FISICA=
COPIA_NUBE=
RUTA_HERRAMIENTAS_MONGO=

# Lectura de etiquetas con un modelo de IA de pago (OPCIONAL, desactivado en el TFG).
# Sin clave, el botón avisa de que no está configurado. La opción gratuita prevista es Tesseract.js (OCR).
ANTHROPIC_API_KEY=
MODELO_IA=claude-haiku-4-5

# Catálogo de cartas de CardTrader (opcional). El token se crea en Ajustes → API de tu perfil de CardTrader.
# Con él, al arrancar con el catálogo vacío se descargan todos los juegos que no tienen API gratuita.
# Para actualizarlo después: npm run catalogo -w servidor
CARDTRADER_TOKEN=
# Ids de juego de CardTrader separados por comas (vacío = todos los que no cubren TCGdex, Scryfall, YGOPRODeck, Lorcast, OPTCG y digimoncard.io)
CARDTRADER_JUEGOS=
